// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
}

model Account {
  accountId            String   @id @default(uuid()) @db.Uuid
  personId             String
  balance              Decimal  @default(0) @db.Decimal(18, 2)
  dailyWithdrawalLimit Decimal  @db.Decimal(18, 2)
  activeFlag           Boolean  @default(true)
  accountType          Int      @db.SmallInt
  createDate           DateTime @default(now())

  transactions Transaction[]

  @@unique([personId, accountType])
  @@index([personId])
  @@map("accounts")
}

model Transaction {
  transactionId   String          @id @default(uuid()) @db.Uuid
  accountId       String          @db.Uuid
  value           Decimal         @db.Decimal(18, 2)
  type            TransactionType
  transactionDate DateTime        @default(now())

  account Account @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId, transactionDate])
  @@map("transactions")
}
